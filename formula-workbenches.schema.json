{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virt.tools/schemas/formula-workbenches.schema.json",
  "title": "Virtual Tools formula workbenches",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "limits", "excluded", "workbenches"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxInputCharacters", "maxAbsoluteInput", "maxFieldsPerFormula", "maxOutputsPerFormula"],
      "properties": {
        "maxInputCharacters": { "type": "integer", "minimum": 16, "maximum": 256 },
        "maxAbsoluteInput": { "type": "number", "exclusiveMinimum": 0 },
        "maxFieldsPerFormula": { "type": "integer", "minimum": 1, "maximum": 20 },
        "maxOutputsPerFormula": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "excluded": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "reason"],
        "properties": {
          "slug": { "$ref": "#/$defs/slug" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "workbenches": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workbench" }
    }
  },
  "$defs": {
    "workbench": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "name", "description", "category", "subcategory", "icon", "risk", "formulas"],
      "properties": {
        "slug": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "subcategory": { "type": "string", "minLength": 1 },
        "icon": { "type": "string", "minLength": 1 },
        "risk": { "enum": ["low", "moderate", "high", "critical"] },
        "formulas": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/formula" }
        }
      }
    },
    "formula": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "name", "description", "fields", "outputs", "note", "guards", "cases", "tests"],
      "properties": {
        "slug": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/field" }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/output" }
        },
        "note": { "type": "string", "minLength": 1 }
        ,
        "guards": { "type": "array", "items": { "$ref": "#/$defs/guard" } },
        "cases": { "type": "array", "items": { "$ref": "#/$defs/case" } },
        "tests": { "type": "array", "items": { "$ref": "#/$defs/test" } }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "unit", "placeholder", "example", "min", "max"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
        "label": { "type": "string", "minLength": 1 },
        "unit": { "type": "string" },
        "placeholder": { "type": "string", "minLength": 1 },
        "example": { "type": "number" },
        "integer": { "type": "boolean" },
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "expression", "unit"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "expression": { "type": "string", "minLength": 1, "maxLength": 500 },
        "unit": { "type": "string" }
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression", "message"],
      "properties": {
        "expression": { "type": "string", "minLength": 1, "maxLength": 500 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "outputs"],
      "properties": {
        "when": { "type": "string", "minLength": 1, "maxLength": 500 },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "input", "expected"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "input": { "type": "object", "additionalProperties": { "type": "number" } },
        "expected": { "type": "array", "minItems": 1, "items": { "type": "number" } }
      }
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
