# Docker receives an explicit build allowlist. Development state, Git history,
# reports, backups, editor files and credentials never enter the build context.
# Directories are allowlisted as a whole so a new script, fixture or data file
# cannot be silently omitted from the image build.
**
!.dockerignore

!api/
!api/**
!frontend/
!frontend/**
!nginx/
!nginx/**
!scripts/
!scripts/**
!tests/
!tests/**
!data/
!data/**

# Local interpreter bytecode is never a build input.
**/__pycache__
**/*.pyc
