[Unit]
Description=One Virtual Tools feedback or new-tool maintenance cycle

[Service]
Type=oneshot
WorkingDirectory=/home/devbot/virt-tools
Environment=PATH=/home/devbot/.local/bin:/home/devbot/.nvm/versions/node/v26.4.0/bin:/usr/local/bin:/usr/bin:/bin
# Refresh existing Docker membership without restarting the long-lived user manager.
ExecStart=/usr/bin/sg docker -c '/bin/bash /home/devbot/virt-tools/scripts/run_feedback_maintenance.sh'
TimeoutStartSec=infinity
UMask=0077
StandardOutput=journal
StandardError=journal
