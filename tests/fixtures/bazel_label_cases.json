{
  "source": "Bazel label and target-pattern documentation",
  "cases": [
    {
      "name": "Absolute package with the target inferred",
      "input": {
        "target": "//my/app",
        "cwd": "my/app/main"
      },
      "expected": {
        "kind": "label",
        "recursive": false,
        "negative": false,
        "inferred": true,
        "repository": null,
        "packageName": "my/app",
        "targetName": "app",
        "canonical": "//my/app:app",
        "expanded": "//my/app:app"
      }
    },
    {
      "name": "Nested absolute package, target inferred from the last segment",
      "input": {
        "target": "//my/app/lib",
        "cwd": ""
      },
      "expected": {
        "kind": "label",
        "recursive": false,
        "negative": false,
        "inferred": true,
        "repository": null,
        "packageName": "my/app/lib",
        "targetName": "lib",
        "canonical": "//my/app/lib:lib",
        "expanded": "//my/app/lib:lib"
      }
    },
    {
      "name": "Explicit target after the colon",
      "input": {
        "target": "//my/app/main:app_binary",
        "cwd": ""
      },
      "expected": {
        "kind": "label",
        "recursive": false,
        "negative": false,
        "inferred": false,
        "repository": null,
        "packageName": "my/app/main",
        "targetName": "app_binary",
        "canonical": "//my/app/main:app_binary",
        "expanded": "//my/app/main:app_binary"
      }
    },
    {
      "name": "Apparent external repository",
      "input": {
        "target": "@rules_go//go:def.bzl",
        "cwd": ""
      },
      "expected": {
        "kind": "label",
        "recursive": false,
        "negative": false,
        "inferred": false,
        "repository": "@rules_go",
        "packageName": "go",
        "targetName": "def.bzl",
        "canonical": "@rules_go//go:def.bzl",
        "expanded": "@rules_go//go:def.bzl"
      }
    },
    {
      "name": "Main repository written canonically",
      "input": {
        "target": "@@//a/b/c",
        "cwd": ""
      },
      "expected": {
        "kind": "label",
        "recursive": false,
        "negative": false,
        "inferred": true,
        "repository": "@@",
        "packageName": "a/b/c",
        "targetName": "c",
        "canonical": "@@//a/b/c:c",
        "expanded": "@@//a/b/c:c"
      }
    },
    {
      "name": "Canonical repository name",
      "input": {
        "target": "@@bazel_tools//tools:defs.bzl",
        "cwd": ""
      },
      "expected": {
        "kind": "label",
        "recursive": false,
        "negative": false,
        "inferred": false,
        "repository": "@@bazel_tools",
        "packageName": "tools",
        "targetName": "defs.bzl",
        "canonical": "@@bazel_tools//tools:defs.bzl",
        "expanded": "@@bazel_tools//tools:defs.bzl"
      }
    },
    {
      "name": "Package wildcard for rule targets",
      "input": {
        "target": "//foo/bar:all",
        "cwd": ""
      },
      "expected": {
        "kind": "rules",
        "recursive": false,
        "negative": false,
        "inferred": false,
        "repository": null,
        "packageName": "foo/bar",
        "targetName": "all",
        "canonical": "//foo/bar:all",
        "expanded": "//foo/bar:all"
      }
    },
    {
      "name": "Package wildcard for every target",
      "input": {
        "target": "//foo/bar:*",
        "cwd": ""
      },
      "expected": {
        "kind": "targets",
        "recursive": false,
        "negative": false,
        "inferred": false,
        "repository": null,
        "packageName": "foo/bar",
        "targetName": "*",
        "canonical": "//foo/bar:*",
        "expanded": "//foo/bar:*"
      }
    },
    {
      "name": "Recursive pattern, :all implied",
      "input": {
        "target": "//foo/...",
        "cwd": ""
      },
      "expected": {
        "kind": "rules",
        "recursive": true,
        "negative": false,
        "inferred": false,
        "repository": null,
        "packageName": "foo",
        "targetName": null,
        "canonical": "//foo/...",
        "expanded": "//foo/...:all"
      }
    },
    {
      "name": "Recursive pattern for every target",
      "input": {
        "target": "//foo/...:*",
        "cwd": ""
      },
      "expected": {
        "kind": "targets",
        "recursive": true,
        "negative": false,
        "inferred": false,
        "repository": null,
        "packageName": "foo",
        "targetName": "*",
        "canonical": "//foo/...:*",
        "expanded": "//foo/...:*"
      }
    },
    {
      "name": "Recursive pattern at the main repository root",
      "input": {
        "target": "//...",
        "cwd": ""
      },
      "expected": {
        "kind": "rules",
        "recursive": true,
        "negative": false,
        "inferred": false,
        "repository": null,
        "packageName": "",
        "targetName": null,
        "canonical": "//...",
        "expanded": "//...:all"
      }
    },
    {
      "name": "Root package wildcard",
      "input": {
        "target": "//:all",
        "cwd": ""
      },
      "expected": {
        "kind": "rules",
        "recursive": false,
        "negative": false,
        "inferred": false,
        "repository": null,
        "packageName": "",
        "targetName": "all",
        "canonical": "//:all",
        "expanded": "//:all"
      }
    },
    {
      "name": "File target in a package subdirectory",
      "input": {
        "target": "//my/app/main:testdata/input.txt",
        "cwd": ""
      },
      "expected": {
        "kind": "label",
        "recursive": false,
        "negative": false,
        "inferred": false,
        "repository": null,
        "packageName": "my/app/main",
        "targetName": "testdata/input.txt",
        "canonical": "//my/app/main:testdata/input.txt",
        "expanded": "//my/app/main:testdata/input.txt"
      }
    },
    {
      "name": "Relative target in the working package",
      "input": {
        "target": ":foo",
        "cwd": "foo"
      },
      "expected": {
        "kind": "label",
        "recursive": false,
        "negative": false,
        "inferred": false,
        "repository": null,
        "packageName": "foo",
        "targetName": "foo",
        "canonical": "//foo:foo",
        "expanded": "//foo:foo"
      }
    },
    {
      "name": "Relative path with an explicit target",
      "input": {
        "target": "bar:wiz",
        "cwd": "foo"
      },
      "expected": {
        "kind": "label",
        "recursive": false,
        "negative": false,
        "inferred": false,
        "repository": null,
        "packageName": "foo/bar",
        "targetName": "wiz",
        "canonical": "//foo/bar:wiz",
        "expanded": "//foo/bar:wiz"
      }
    },
    {
      "name": "Relative recursive pattern",
      "input": {
        "target": "bar/...",
        "cwd": "foo"
      },
      "expected": {
        "kind": "rules",
        "recursive": true,
        "negative": false,
        "inferred": false,
        "repository": null,
        "packageName": "foo/bar",
        "targetName": null,
        "canonical": "//foo/bar/...",
        "expanded": "//foo/bar/...:all"
      }
    },
    {
      "name": "Relative recursive pattern from the working directory",
      "input": {
        "target": "...",
        "cwd": "foo"
      },
      "expected": {
        "kind": "rules",
        "recursive": true,
        "negative": false,
        "inferred": false,
        "repository": null,
        "packageName": "foo",
        "targetName": null,
        "canonical": "//foo/...",
        "expanded": "//foo/...:all"
      }
    },
    {
      "name": "Relative path with no colon, three readings",
      "input": {
        "target": "bar/wiz",
        "cwd": "foo"
      },
      "expected": {
        "kind": "ambiguous",
        "recursive": false,
        "negative": false,
        "inferred": false,
        "repository": null,
        "packageName": null,
        "targetName": null,
        "canonical": null,
        "expanded": null,
        "candidates": [
          "//foo/bar/wiz:wiz",
          "//foo/bar:wiz",
          "//foo:bar/wiz"
        ]
      }
    },
    {
      "name": "Negative recursive pattern",
      "input": {
        "target": "-//foo/...",
        "cwd": ""
      },
      "expected": {
        "kind": "rules",
        "recursive": true,
        "negative": true,
        "inferred": false,
        "repository": null,
        "packageName": "foo",
        "targetName": null,
        "canonical": "//foo/...",
        "expanded": "//foo/...:all"
      }
    },
    {
      "name": "Relative recursive pattern for every target",
      "input": {
        "target": "bar/...:all-targets",
        "cwd": "foo"
      },
      "expected": {
        "kind": "targets",
        "recursive": true,
        "negative": false,
        "inferred": false,
        "repository": null,
        "packageName": "foo/bar",
        "targetName": "all-targets",
        "canonical": "//foo/bar/...:all-targets",
        "expanded": "//foo/bar/...:all-targets"
      }
    }
  ]
}
